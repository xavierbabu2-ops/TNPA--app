{
  "entities": {
    "MemberRegistration": {
      "title": "MemberRegistration",
      "description": "Tamil Nadu Painters and Artists Association Member Registration details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "regNumber": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "fatherName": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "aadhaar": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "taluk": { "type": "string" },
        "villageOrTown": { "type": "string" },
        "pinCode": { "type": "string" },
        "address": { "type": "string" },
        "profession": { "type": "string" },
        "experienceYears": { "type": "number" },
        "specialization": { "type": "string" },
        "photoUrl": { "type": "string" },
        "cardFrontUrl": { "type": "string" },
        "cardBackUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "under_review", "needs_correction"] },
        "correctionRemarks": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "fatherName", "phone", "aadhaar", "district", "address", "experienceYears", "status"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Union subscription and donation payment ledger entries.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "paymentType": { "type": "string", "enum": ["membership", "donation", "welfare_fund", "renewal", "event", "training", "other"] },
        "paymentTypeTa": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "pending", "failed"] }
      },
      "required": ["id", "memberId", "memberName", "amount", "paymentDate", "paymentType", "transactionId", "status"]
    },
    "WelfareApplication": {
      "title": "WelfareApplication",
      "description": "Claims made by approved association members for government welfare assistance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberPhone": { "type": "string" },
        "schemeId": { "type": "string" },
        "schemeTitle": { "type": "string" },
        "schemeTitleEn": { "type": "string" },
        "amount": { "type": "string" },
        "appliedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "under_review", "needs_correction"] },
        "district": { "type": "string" },
        "remarks": { "type": "string" }
      },
      "required": ["id", "memberId", "memberName", "memberPhone", "schemeId", "schemeTitleEn", "amount", "appliedAt", "status", "district"]
    },
    "UnionConfig": {
      "title": "UnionConfig",
      "description": "Global union configuration, custom ID card templates, logo, seals, and live broadcasts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customLogoUrl": { "type": "string" },
        "customEmblemUrl": { "type": "string" },
        "customFlagUrl": { "type": "string" },
        "presidentName": { "type": "string" },
        "secretaryName": { "type": "string" },
        "treasurerName": { "type": "string" },
        "emergencyAlert": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id"]
    },
    "Leader": {
      "title": "Leader",
      "description": "State and District Office Bearers directory.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "role": { "type": "string" },
        "roleEn": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "district": { "type": "string" },
        "districtEn": { "type": "string" }
      },
      "required": ["id", "name", "role", "phone", "district"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Official union announcements, circulars, and events.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "content": { "type": "string" },
        "contentEn": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "categoryTa": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "title", "content", "date", "category"]
    },
    "ExecutiveMember": {
      "title": "ExecutiveMember",
      "description": "Office bearer details across State, District, Zone, and Area/Union administrative tiers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "level": { "type": "string", "enum": ["state", "district", "zone", "union_area"] },
        "role": { "type": "string" },
        "roleEn": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "district": { "type": "string" },
        "districtEn": { "type": "string" },
        "zone": { "type": "string" },
        "zoneEn": { "type": "string" },
        "unitType": { "type": "string" },
        "unitName": { "type": "string" },
        "status": { "type": "string" },
        "appointedDate": { "type": "string" }
      },
      "required": ["id", "name", "level", "role", "phone", "status"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/MemberRegistration" },
      "description": "Registration database for union membership applicants."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Secure payment logs ledger for union subscription transactions."
    },
    "/welfare_applications/{welfareId}": {
      "schema": { "$ref": "#/entities/WelfareApplication" },
      "description": "Member applications for various government and union welfare schemes."
    },
    "/union_config/{configId}": {
      "schema": { "$ref": "#/entities/UnionConfig" },
      "description": "Global ID card configuration, logos, state seals, and emergency alert messages."
    },
    "/leaders/{leaderId}": {
      "schema": { "$ref": "#/entities/Leader" },
      "description": "Directory of state and district office bearers and leaders."
    },
    "/executives/{execId}": {
      "schema": { "$ref": "#/entities/ExecutiveMember" },
      "description": "Separate executive directory for State, District, Zone, and Area/Union tiers."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsItem" },
      "description": "Broadcast news and official union circulars visible to all app users."
    }
  }
}
