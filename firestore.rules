rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role Lookup
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          'email' in request.auth.token &&
          (
            request.auth.token.email.endsWith('@tnpaintunion.gov.in') ||
            request.auth.token.email == 'stateadmin@tnpaintunion.org' ||
            request.auth.token.email == 'xavierbabu2@gmail.com'
          )
        )
      );
    }

    // 1. REGISTRATIONS COLLECTION (Visible to all union app downloaders)
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if isValidRegistration(request.resource.data);
      allow update: if isValidRegistration(request.resource.data) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidRegistration(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.fatherName is string && data.fatherName.size() > 0 && data.fatherName.size() <= 200 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
             data.address is string && data.address.size() > 0 && data.address.size() <= 1000 &&
             data.status in ["pending", "approved", "rejected", "under_review", "needs_correction"];
    }

    // 2. UNION CONFIG (ID card settings, official logos, state seal, emergency alert visible to all users)
    match /union_config/{configId} {
      allow read: if true;
      allow write: if true; // Allows super admin real-time sync across devices
    }

    // 3. LEADERS & OFFICE BEARERS (Visible to all users)
    match /leaders/{leaderId} {
      allow read: if true;
      allow write: if true;
    }

    // 3b. EXECUTIVES HIERARCHY (State, District, Zone, Area/Union)
    match /executives/{execId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. NEWS & CIRCULARS (Visible to all users)
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. DISTRICT BROADCASTS (Visible to all users)
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. PAYMENTS COLLECTION
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if isValidPayment(request.resource.data);
      allow update, delete: if isAdmin();
    }

    function isValidPayment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.memberId is string && data.memberId.size() <= 128 &&
             data.memberName is string && data.memberName.size() <= 200 &&
             data.amount is number && data.amount > 0 && data.amount <= 1000000 &&
             data.status in ["success", "pending", "failed"];
    }

    // 7. WELFARE APPLICATIONS COLLECTION
    match /welfare_applications/{welfareId} {
      allow read: if true;
      allow create: if isValidWelfareApp(request.resource.data);
      allow update, delete: if true;
    }

    function isValidWelfareApp(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.memberId is string && data.memberId.size() <= 128 &&
             data.memberName is string && data.memberName.size() <= 200 &&
             data.memberPhone is string && data.memberPhone.size() >= 10 &&
             data.schemeId is string && data.schemeId.size() <= 128 &&
             data.schemeTitleEn is string && data.schemeTitleEn.size() <= 300 &&
             data.district is string && data.district.size() <= 100;
    }

    // 8. ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // 10. GALLERY PHOTOS & VIDEOS
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if true;
    }

    match /gallery_videos/{videoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

